# Oracle ulanishi (mavjud .env faylingizdagi qiymatlarni saqlang)
DB_USER=
DB_PASSWORD=
DB_CONNECT_STRING=
DB_POOL_MIN=1
DB_POOL_MAX=10

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=1d
PORT=5001
FRONTEND_URL=http://localhost:5173

# Parol tiklash xatlari uchun SMTP (masalan Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
